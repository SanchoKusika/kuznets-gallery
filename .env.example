# Copy to .env.local. OpenNext bundles the Next .env files into the Worker, so keep only site settings here.

# Supabase project (Settings → API). Both are used on the server only; the publishable key is not a secret.
SUPABASE_URL=https://jagdvpeddgzyyqhjliav.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# Base URL for catalogue images (the public «artworks» bucket); next.config.ts allows this host for next/image.
NEXT_PUBLIC_IMAGE_BASE=https://jagdvpeddgzyyqhjliav.supabase.co/storage/v1/object/public/artworks/

# Public origin used for the sitemap and OG URLs. Only https://kuznets.uz is indexed; any other origin
# (a workers.dev preview) gets Disallow in robots.txt and noindex. For a deploy, set it in .env.production.local.
NEXT_PUBLIC_SITE_URL=https://kuznets.uz

# Only for scripts/db/* (import, demo seed) — put these two in .env.scripts, not here:
#   ADMIN_LOGIN=admin
#   ADMIN_PASSWORD=
# and run node --env-file=.env.local --env-file=.env.scripts scripts/db/….

# Supabase project (Settings → API). Both are used on the server only; the publishable key is not a secret.
SUPABASE_URL=https://jagdvpeddgzyyqhjliav.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# Base URL for catalogue images (the public «artworks» bucket); next.config.ts allows this host for next/image.
NEXT_PUBLIC_IMAGE_BASE=https://jagdvpeddgzyyqhjliav.supabase.co/storage/v1/object/public/artworks/

# Public origin used for the sitemap and OG URLs. Optional: on Vercel it defaults to the project's production domain.
# Only a production build for https://kuznets.uz is indexed; any other origin (a *.vercel.app demo) or a PR preview
# gets Disallow in robots.txt and noindex; so does a local build without it.
# NEXT_PUBLIC_SITE_URL=https://kuznets.uz

# Yandex Maps JS API 3.0 key for the footer map (developer.tech.yandex.ru). Read on the server and handed to the map;
# the browser sends it to Yandex, so the cabinet limits it by HTTP Referer (localhost, kuznets-gallery.vercel.app).
# Without it the map shows the fallback text.
YANDEX_MAPS_KEY=

# Only for scripts/db/* (import, demo seed): an admin account they sign in with.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
